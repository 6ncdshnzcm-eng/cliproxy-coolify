# Select one network mode: direct, bundled, or external.
COMPOSE_PROFILES=direct
# Coolify generates this name. Local Compose uses the value below.
SERVICE_NAME_CLIPROXY=cliproxy

# Generate each key separately with: openssl rand -hex 32
# The API key is only required when creating a new data volume.
CLIPROXY_API_KEY=
CLIPROXY_MANAGEMENT_KEY=

# Optional image overrides. CLIProxyAPI images must support the v8 configuration format.
# CLIPROXY_IMAGE=eceasy/cli-proxy-api:latest
# GLUETUN_IMAGE=ghcr.io/qdm12/gluetun:latest

# Required only with the external profile.
GLUETUN_CONTAINER=
# Public HTTPS URL served by the existing Gluetun stack in Coolify.
CLIPROXY_PUBLIC_URL=

# VPN credentials below are used only with the bundled profile.
# Default: a custom WireGuard profile. Use an IP address for the endpoint.
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_PRESHARED_KEY=

# For a built-in Gluetun provider, set VPN_SERVICE_PROVIDER above.
# Use VPN_TYPE=openvpn for OpenVPN credentials.
OPENVPN_USER=
OPENVPN_PASSWORD=
SERVER_COUNTRIES=
